rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and user-specific attendance data
    match /users/{userId} {
      allow get, update, create, delete: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      // Subcollections under user: data/attendance, data/calendarSync, etc.
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
